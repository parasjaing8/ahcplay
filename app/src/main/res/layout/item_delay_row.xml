<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/selector_row_player"
    android:focusable="true" android:clickable="true"
    android:paddingHorizontal="24dp" android:paddingVertical="12dp">
    <ImageView android:layout_width="24dp" android:layout_height="24dp"
        android:layout_marginEnd="20dp" android:src="@drawable/ic_audio_delay"
        android:importantForAccessibility="no" />
    <TextView android:id="@+id/delay_label"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:textColor="#B3FFFFFF" android:textSize="17sp" />
    <TextView android:id="@+id/delay_value"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#FFFFFF" android:textSize="17sp" />
</LinearLayout>
