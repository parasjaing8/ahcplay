<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/selector_row_player"
    android:focusable="true" android:clickable="true"
    android:paddingHorizontal="24dp" android:paddingVertical="14dp">
    <ImageView android:id="@+id/menu_icon"
        android:layout_width="26dp" android:layout_height="26dp"
        android:layout_marginEnd="24dp" android:importantForAccessibility="no" />
    <TextView android:id="@+id/menu_label"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:textColor="#FFFFFF" android:textSize="18sp" />
    <TextView android:id="@+id/menu_value"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#B3FFFFFF" android:textSize="15sp" android:layout_marginStart="12dp" />
</LinearLayout>
